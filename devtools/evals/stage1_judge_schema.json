{
  "type": "object",
  "required": ["scenario_id", "scores", "violations", "evidence", "confidence"],
  "additionalProperties": false,
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "scores": {
      "type": "object",
      "required": [
        "identity_continuity",
        "alien_world_boundary",
        "memory_grounding",
        "history_continuity",
        "naturalness"
      ],
      "additionalProperties": false,
      "properties": {
        "identity_continuity": {"type": "integer", "minimum": 1, "maximum": 5},
        "alien_world_boundary": {"type": "integer", "minimum": 1, "maximum": 5},
        "memory_grounding": {"type": "integer", "minimum": 1, "maximum": 5},
        "history_continuity": {"type": "integer", "minimum": 1, "maximum": 5},
        "naturalness": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "violations": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
