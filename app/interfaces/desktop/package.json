{
  "name": "elfienest-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ElfieNest 跨平台桌面应用外壳",
  "main": "main.js",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "test": "pnpm build && node --test ../../../build/components/desktop-interface/application_menu.test.js ../../../build/components/desktop-interface/resources/resource_manifest.test.js ../../../build/components/desktop-interface/desktop_role_lifecycle.test.js ../../../build/components/desktop-interface/lifecycle_client.test.js",
    "build-resource-manifest": "pnpm build && node ../../../build/components/desktop-interface/resources/build_resource_manifest.js",
    "dev": "pnpm build && electron ../../../build/components/desktop-interface/main.js",
    "package": "pnpm build && electron-builder --publish never"
  },
  "build": {
    "appId": "com.elfienest.desktop",
    "productName": "ElfieNest",
    "artifactName": "ElfieNest-${version}-internal-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      {
        "from": "../../../build/components/desktop-interface",
        "to": ".",
        "filter": ["**/*"]
      },
      {
        "from": "../../../godot_runtime/electron",
        "to": "godot_runtime/electron",
        "filter": ["**/*"]
      },
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/staging/${env.ELFIENEST_TARGET}/resources",
        "to": "."
      }
    ],
    "mac": {
      "icon": "assets/elfienest.png",
      "target": ["dmg"]
    },
    "win": {
      "icon": "assets/elfienest.png",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "assets/elfienest.png",
      "target": ["AppImage"]
    },
    "directories": {
      "output": "../../../dist"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "electron-winstaller"]
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0"
  }
}
