{
  "name": "elfienest-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ElfieNest 跨平台桌面应用外壳",
  "main": "main.js",
  "scripts": {
    "build": "pnpm exec tsc -p tsconfig.json",
    "test": "pnpm build && node --test ../build/components/desktop/platform/supervisor_config.test.js ../build/components/desktop/supervisor/supervisor.test.js ../build/components/desktop/resources/resource_manifest.test.js",
    "build-resource-manifest": "pnpm build && node ../build/components/desktop/resources/build_resource_manifest.js",
    "dev": "pnpm build && electron ../build/components/desktop/main.js",
    "package": "pnpm build && electron-builder"
  },
  "build": {
    "appId": "com.elfienest.desktop",
    "productName": "ElfieNest",
    "asar": true,
    "files": [
      {
        "from": "../build/components/desktop",
        "to": ".",
        "filter": ["**/*"]
      },
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/staging/${env.ELFIENEST_TARGET}/resources",
        "to": "."
      }
    ],
    "mac": {
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage"]
    },
    "directories": {
      "output": "../dist"
    }
  },
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.8.0"
  }
}
