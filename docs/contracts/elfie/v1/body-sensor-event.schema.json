{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "description": "Stable identity and origin category for a message actor.",
      "properties": {
        "actor_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Actor Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "source_kind": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "source_kind"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "EnvironmentSample": {
      "additionalProperties": false,
      "properties": {
        "humidity_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Humidity Ratio"
        },
        "illuminance_lux": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Illuminance Lux"
        },
        "kind": {
          "const": "environment_sample",
          "title": "Kind",
          "type": "string"
        },
        "temperature_celsius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature Celsius"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EnvironmentSample",
      "type": "object"
    },
    "MediaRef": {
      "additionalProperties": false,
      "description": "Reference to media stored outside typed message payloads.",
      "properties": {
        "media_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Media Id",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Mime Type",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "uri": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "media_id",
        "uri",
        "mime_type"
      ],
      "title": "MediaRef",
      "type": "object"
    },
    "ProprioceptionSample": {
      "additionalProperties": false,
      "properties": {
        "arrived": {
          "default": false,
          "title": "Arrived",
          "type": "boolean"
        },
        "kind": {
          "const": "proprioception_sample",
          "title": "Kind",
          "type": "string"
        },
        "posture": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Posture",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "kind",
        "posture"
      ],
      "title": "ProprioceptionSample",
      "type": "object"
    },
    "TactileImpact": {
      "additionalProperties": false,
      "properties": {
        "force_newtons": {
          "minimum": 0,
          "title": "Force Newtons",
          "type": "number"
        },
        "kind": {
          "const": "tactile_impact",
          "title": "Kind",
          "type": "string"
        },
        "location": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Location",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "location",
        "force_newtons"
      ],
      "title": "TactileImpact",
      "type": "object"
    },
    "UtteranceFinal": {
      "additionalProperties": false,
      "properties": {
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "kind": {
          "const": "utterance_final",
          "title": "Kind",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "text": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "UtteranceFinal",
      "type": "object"
    },
    "VisionChange": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "const": "vision_change",
          "title": "Kind",
          "type": "string"
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/$defs/MediaRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "title": "VisionChange",
      "type": "object"
    },
    "VisionSample": {
      "additionalProperties": false,
      "properties": {
        "height_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height Px"
        },
        "kind": {
          "const": "vision_sample",
          "title": "Kind",
          "type": "string"
        },
        "media": {
          "$ref": "#/$defs/MediaRef"
        },
        "width_px": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width Px"
        }
      },
      "required": [
        "kind",
        "media"
      ],
      "title": "VisionSample",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Body Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "environment_sample": "#/$defs/EnvironmentSample",
          "proprioception_sample": "#/$defs/ProprioceptionSample",
          "tactile_impact": "#/$defs/TactileImpact",
          "utterance_final": "#/$defs/UtteranceFinal",
          "vision_change": "#/$defs/VisionChange",
          "vision_sample": "#/$defs/VisionSample"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/UtteranceFinal"
        },
        {
          "$ref": "#/$defs/VisionSample"
        },
        {
          "$ref": "#/$defs/VisionChange"
        },
        {
          "$ref": "#/$defs/TactileImpact"
        },
        {
          "$ref": "#/$defs/ProprioceptionSample"
        },
        {
          "$ref": "#/$defs/EnvironmentSample"
        }
      ],
      "title": "Payload"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ActorRef"
    }
  },
  "required": [
    "event_id",
    "body_id",
    "source",
    "occurred_at",
    "received_at",
    "payload"
  ],
  "title": "BodySensorEvent",
  "type": "object"
}
