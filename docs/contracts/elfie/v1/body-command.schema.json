          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "intensity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intensity"
        },
