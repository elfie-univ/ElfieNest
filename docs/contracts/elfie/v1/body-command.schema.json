{
  "$defs": {
    "EmergencyStopCommand": {
      "additionalProperties": false,
      "properties": {
        "body_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Body Id",
          "type": "string"
        },
        "capability_revision": {
          "minimum": 1,
          "title": "Capability Revision",
          "type": "integer"
        },
        "command_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Command Id",
          "type": "string"
        },
        "command_type": {
          "const": "emergency_stop",
          "title": "Command Type",
          "type": "string"
        },
        "deadline": {
          "format": "date-time",
          "title": "Deadline",
          "type": "string"
        },
        "intent_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Intent Id",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Reason",
          "type": "string"
        },
        "turn_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Turn Id",
          "type": "string"
        }
      },
      "required": [
        "command_id",
        "turn_id",
        "intent_id",
        "body_id",
        "issued_at",
        "deadline",
        "capability_revision",
        "command_type",
        "reason"
      ],
      "title": "EmergencyStopCommand",
      "type": "object"
    },
    "ExpressionCommand": {
