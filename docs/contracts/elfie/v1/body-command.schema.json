        "command_type",
        "kind"
      ],
      "title": "ExpressionCommand",
      "type": "object"
    },
    "MediaRef": {
      "additionalProperties": false,
      "description": "Reference to media stored outside typed message payloads.",
      "properties": {
        "media_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Media Id",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Mime Type",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "uri": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "media_id",
        "uri",
        "mime_type"
      ],
      "title": "MediaRef",
      "type": "object"
    },
