{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "description": "Stable identity and origin category for a message actor.",
      "properties": {
        "actor_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Actor Id",
          "type": "string"
        },
        "display_name": {
          "anyOf": [
            {
              "maxLength": 8192,
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Name"
        },
        "source_kind": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "source_kind"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "Priority": {
      "description": "Scheduling priority shared by message-producing subsystems.",
      "enum": [
        "critical",
        "high",
        "normal",
        "low"
      ],
      "title": "Priority",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Identity, timing, origin, and trace data shared by every message.",
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "correlation_id": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Correlation Id"
    },
    "elfie_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Elfie Id",
      "type": "string"
    },
    "event_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "priority": {
      "$ref": "#/$defs/Priority",
      "default": "normal"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/ActorRef"
    },
    "trace_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "elfie_id",
    "source",
    "occurred_at",
    "received_at",
    "trace_id"
  ],
  "title": "MessageMeta",
  "type": "object"
}
