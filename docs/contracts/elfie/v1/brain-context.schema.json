        "payload": {
          "discriminator": {
            "mapping": {
              "execution": "#/$defs/ExecutionPayload",
              "internal": "#/$defs/InternalPayload",
              "physical": "#/$defs/PhysicalPayload",
              "social": "#/$defs/SocialPayload"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PhysicalPayload"
            },
            {
              "$ref": "#/$defs/SocialPayload"
            },
            {
              "$ref": "#/$defs/ExecutionPayload"
            },
            {
              "$ref": "#/$defs/InternalPayload"
            }
          ],
          "title": "Payload"
        },
        "salience": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Salience",
          "type": "number"
        }
      },
      "required": [
        "meta",
        "payload",
        "failed_frame_id",
        "failed_cutoff_seq",
        "failure_count",
        "failure_reason"
