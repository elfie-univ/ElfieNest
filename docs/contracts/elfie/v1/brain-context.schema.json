    "ProcessingFailureEvent": {
      "additionalProperties": false,
      "description": "Reliable evidence emitted after a frame fails three times.",
      "properties": {
        "failed_cutoff_seq": {
          "minimum": 0,
          "title": "Failed Cutoff Seq",
          "type": "integer"
        },
        "failed_frame_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Failed Frame Id",
          "type": "string"
        },
        "failure_count": {
          "minimum": 1,
          "title": "Failure Count",
          "type": "integer"
        },
        "failure_reason": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Failure Reason",
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/MessageMeta"
