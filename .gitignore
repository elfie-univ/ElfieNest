# =========================================================================
# ElfieNest Git 忽略规则配置 (.gitignore)
# =========================================================================

# 1. 公开文档站源码纳入版本控制；历史草稿统一放入被忽略的 .omo/
/docs/node_modules/
/docs/.vitepress/cache/
/docs/.vitepress/dist/

# 2. AI Runtime 本地敏感配置与托管二进制（保留旧路径用于升级迁移）
/ai_runtime/runtime_config.json
/ai_runtime/runtime_config*.bak
/ai_runtime/bin/
/runtime/runtime_config.json
/runtime/runtime_config*.bak
/runtime/bin/

# 3. 敏感环境变量与密钥
.env
.env.*
!.env.example
config.yaml

# 4. 数据库文件（已统一迁移到 data/ 目录）
.elfie_memory.db
.elfie_memory.db-shm
.elfie_memory.db-wal
.elfie_memory.db.backup

# 5. Python 标准临时文件与缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/
*.egg-info/
*.egg
build/
dist/
# Keep the setuptools metadata output directory available in clean checkouts.
!/build/
/build/*
!/build/metadata/
/build/metadata/*
!/build/metadata/.gitignore
!/build/components/
/build/components/*
!/build/components/runtime-contract/
/build/components/runtime-contract/*
!/build/components/runtime-contract/runtime-components.json

# 6. IDE/编辑器/工具缓存与日志
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~
*.blend1
.mypy_cache/
.ruff_cache/
.playwright-mcp/

# 6. 运行时数据（DB、精灵配置等）
data/
/.elfienest.local/

# 7. 本地过程材料与代理知识（只供本机整理，不提交、不参与 Docs 构建）
/.omo/
/.sisyphus/
/.agents/knowledge/
/ElfieNest.worktree/

# 7. Godot 4+ 虚拟空间本地编译与导入缓存 (防止二进制资产及缓存进入仓库)
/godot_project/.godot/
/godot_project/android/


# Project agent skills are shared; keep other local agent state ignored.
/.agents/*
!/.agents/skills/
!/.agents/skills/**

# Runtime temp files (audio, cache, etc.)
data/temp/
*.uid

# Electron 本地依赖；构建产物只能写入根 build/dist
/app/interfaces/desktop/node_modules/
/app/interfaces/desktop/dist/
/app/interfaces/desktop/out/

# Developer Tools Web local dependencies
/devtools/web/node_modules/

# ZCode CLI workspace metadata
.zcode/
.pnpm-store/
