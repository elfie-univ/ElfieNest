# =========================================================================
# ElfieNest Git 忽略规则配置 (.gitignore)
# =========================================================================

# 1. 用户要求屏蔽的设计与规格文档目录
/docs/

# 2. 算力底座本地敏感配置与托管二进制 (安全防泄漏)
/runtime/runtime_config.json
/runtime/bin/

# 3. 敏感环境变量与密钥
.env
.env.*
!.env.example
config.yaml
.elfie_memory.db

# 4. Python 标准临时文件与缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/
*.egg-info/
*.egg
build/
dist/
# 5. macOS 系统与 IDE 编辑器垃圾文件
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~

# 6. Sisyphus/OpenCode 工作目录 (本地状态，不提交)
.omo/
.sisyphus/
ElfieNest.worktree/

# 7. Godot 4+ 虚拟空间本地编译与导入缓存 (防止二进制资产及缓存进入仓库)
/assets/.godot/
/assets/android/


