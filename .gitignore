# =========================================================================
# ElfieNest Git 忽略规则配置 (.gitignore)
# =========================================================================

# 1. 用户要求屏蔽的设计与规格文档目录
/docs/
/Docs/

# 2. 算力底座本地敏感配置与托管二进制 (安全防泄漏)
/runtime/runtime_config.json
/runtime/runtime_config*.bak
/runtime/bin/

# 3. 敏感环境变量与密钥
.env
.env.*
!.env.example
config.yaml

# 4. 数据库文件（已统一迁移到 data/ 目录）
.elfie_memory.db
.elfie_memory.db-shm
.elfie_memory.db-wal
.elfie_memory.db.backup

# 5. Python 标准临时文件与缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/
*.egg-info/
*.egg
build/
dist/

# 6. IDE/编辑器/工具缓存与日志
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~
.mypy_cache/
.ruff_cache/
.playwright-mcp/

# 6. 运行时数据（DB、精灵配置等）
data/

# 7. Sisyphus/OpenCode 工作目录 (本地状态，不提交)
.omo/
.sisyphus/
ElfieNest.worktree/

# 7. Godot 4+ 虚拟空间本地编译与导入缓存 (防止二进制资产及缓存进入仓库)
/godot/.godot/
/godot/android/


# OpenCode agent skills (project-level)
.agents/

# Runtime temp files (audio, cache, etc.)
data/temp/
*.uid
